# Secrets — never commit. (.env.example IS committed.)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Data: raw PDFs and generated indexes stay local
data/raw/*
!data/raw/.gitkeep
chroma_db/

# Node / React (frontend/)
node_modules/
dist/
build/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & OS
.DS_Store
.vscode/
.idea/
*.swp
*.pem
data/index/
